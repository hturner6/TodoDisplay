CLIENT_ID=
CLIENT_SECRET=
ACCESS_TOKEN=
# Optional: defaults to the project the display has always shown
TICKTICK_PROJECT_ID=
# Optional: defaults to https://localhost:3000, must match the redirect set on the TickTick app
TICKTICK_REDIRECT_URI=
DISPLAY_MARGINS=
# Optional: HH:MM-HH:MM when the screen is left alone (default 23:00-06:00), or off
QUIET_HOURS=
TODOAPP_PROJECT_ID=
TODOAPP_SPACE_ID=
TODOAPP_KEY_FILE=
TASK_SOURCE=
# Optional: where to show the weather for; leave both empty for none. Kept to one decimal when sent.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
# Optional: a Polish word of the day under the tasks (default on); off to hide it
WORD_OF_THE_DAY=
